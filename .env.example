# Server
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/skillspring
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://your-skillspring.vercel.app
PORT=5000
AI_API_KEY=your-provider-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Instructor invitation links and transactional email (Resend)
APP_URL=http://localhost:5173
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM=SkillSpring <invitations@your-verified-domain.com>

# Client (set in Vercel
VITE_API_URL=https://your-skillspring-api.onrender.com/api
